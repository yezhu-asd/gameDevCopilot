# ============================================================
# GameDevCopilot 环境配置
# 复制本文件为 .env 后填写：cp .env.example .env
# 注意：.env 已被 gitignore，不会提交到仓库，请勿改名提交
# ============================================================

# ------------------------------------------------------------
# LLM 模型配置（必填）
# 使用 OpenAI 兼容接口（兼容 DeepSeek / 智谱 / 通义 / 硅基流动等）
# ------------------------------------------------------------
# 模型服务商：openai-compatible | azure
MODEL_PROVIDER=openai-compatible

# API Key（必填，去对应平台控制台申请）
LLM_API_KEY=你的_API_KEY

# API 地址（按服务商填）
# DeepSeek:   https://api.deepseek.com
# 智谱:       https://open.bigmodel.cn/api/paas/v4
# 通义:       https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名（按服务商支持填）
# DeepSeek:   deepseek-chat / deepseek-reasoner
# 智谱:       glm-4-flash / glm-4-plus
# 通义:       qwen-plus / qwen-max
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------
# Azure OpenAI（仅当 MODEL_PROVIDER=azure 时使用）
# ------------------------------------------------------------
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_VERSION=2023-05-15

# ------------------------------------------------------------
# Agent 行为（可选）
# ------------------------------------------------------------
# 自动修复最大轮数（生成失败后最多修复几次）
MAX_FIX_ROUNDS=3

# 单次生成最多输出文件数
MAX_FILES_PER_GEN=8

# ------------------------------------------------------------
# Godot 无头验证（可选）
# ------------------------------------------------------------
# 无头验证超时（秒）。生成游戏跑挂时超时强制结束，防止卡死
VERIFY_TIMEOUT_SEC=30

# ------------------------------------------------------------
# RAG 知识库（可选）
# ------------------------------------------------------------
# bge-m3 模型路径。默认取项目内 models/bge-m3，若模型在别处请填写绝对路径
# BGE_MODEL_DIR=E:/path/to/models/bge-m3
